# ---- Backend (copy to backend/.env or set in your host's dashboard) ----
# Comma-separated list of allowed frontend origins (CORS). Include your deployed Vercel URL in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=10
ENABLE_OCR=true
# Optional: override where model.joblib / metrics.json / feature_schema.json are loaded from
# MODEL_ARTIFACT_DIR=

# ---- Frontend (frontend/.env.local) ----
VITE_API_BASE_URL=http://localhost:8000
VITE_MAX_UPLOAD_MB=10
